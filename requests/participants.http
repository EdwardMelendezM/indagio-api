@host = http://localhost:8080
@api = {{host}}/api
@accessToken = your_access_token_here

@projectId = 11111111-1111-1111-1111-111111111111
@participantId = 22222222-2222-2222-2222-222222222222
@participantCode = P-001

### Create participant
POST {{api}}/projects/{{projectId}}/participants
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "display_name": "Ana García",
  "external_identifier": "participant-101"
}

### List participants
GET {{api}}/projects/{{projectId}}/participants
Authorization: Bearer {{accessToken}}

### Get participant by code
GET {{api}}/projects/{{projectId}}/participants/code/{{participantCode}}
Authorization: Bearer {{accessToken}}

### Update participant status
PATCH {{api}}/projects/{{projectId}}/participants/{{participantId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "active"
}
