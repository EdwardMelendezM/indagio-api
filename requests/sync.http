@host = http://localhost:8080
@api = {{host}}/api

@projectId = 11111111-1111-1111-1111-111111111111
@participantId = 22222222-2222-2222-2222-222222222222
@actorId = 33333333-3333-3333-3333-333333333333
@clientBatchId = sync-batch-001

### Submit sync batch
POST {{api}}/sync/batches
X-Actor-ID: {{actorId}}
Content-Type: application/json

{
  "project_id": "{{projectId}}",
  "participant_id": "{{participantId}}",
  "client_generated_batch_id": "{{clientBatchId}}",
  "payload": {
    "answers": [
      {"question_key": "satisfaction", "value": 5},
      {"question_key": "comments", "value": "Great experience."}
    ]
  }
}

### List sync batches
GET {{api}}/sync/batches?participant_id={{participantId}}
X-Actor-ID: {{actorId}}
