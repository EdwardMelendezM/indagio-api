### SECTION 6: MARK READ
### ================================================================

### 6.1 Mark messages as read
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "mark_read",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "last_read_message_id": "REPLACE_WITH_MESSAGE_ID"
  },
  "request_id": "read-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Mark read: " + message);
        client.test("Received read_receipt broadcast", () => {
            client.assert(json.type === "read_receipt" || json.request_id === "read-001");
        });
        unsubscribe();
    });
%}

