### WebSocket Test Suite
### ================================================================
### PREREQUISITES:
### 1. Get a valid access_token from auth.http (Login or Verify OTP)
### 2. Get a conversation ID between two users
### 3. Get user IDs of both users
### ================================================================

### Variables
@baseWsUrl = ws://localhost:8080/ws/chat
@baseApiUrl = http://localhost:8080/api

### Replace with your actual values
@accessToken = YOUR_ACCESS_TOKEN_HERE
@userId = YOUR_USER_ID_HERE
@otherUserId = OTHER_USER_ID_HERE
@conversationId = CONVERSATION_ID_HERE

---

### ================================================================
### SECTION 1: CONNECTION & AUTHENTICATION
### ================================================================

### 1.1 Connect to WebSocket (authenticated)
### URL: {{baseWsUrl}}?token={{accessToken}}
### The token is passed as a query parameter for authentication
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "ping",
  "payload": {},
  "request_id": "conn-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Received: " + message);
        client.test("Connection successful", () => {
            client.assert(json.type === "pong" || json.type === "connected");
        });
        if (json.type === "pong") {
            unsubscribe();
        }
    });
%}

---

### ================================================================
### SECTION 2: PING/PONG HEARTBEAT
### ================================================================

### 2.1 Send Ping - expect Pong response
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "ping",
  "payload": {},
  "request_id": "ping-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Ping response: " + message);
        client.test("Received pong", () => {
            client.assert(json.type === "pong");
        });
        client.test("Request ID matches", () => {
            client.assert(json.request_id === "ping-001");
        });
        unsubscribe();
    });
%}

---

### ================================================================
### SECTION 3: ACTIVE CONVERSATION (Push Gating - NEW)
### ================================================================

### 3.1 Set active conversation (user is viewing a conversation)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "active_conversation",
  "payload": {"conversation_id": "{{conversationId}}"},
  "request_id": "active-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Active conversation set: " + message);
        // This frame doesn't receive a direct response, just log it
        if (json.request_id === "active-001") {
            unsubscribe();
        }
    });
%}

### 3.2 Clear active conversation (user is on listings/settings/background)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "active_conversation",
  "payload": {"conversation_id": null},
  "request_id": "active-002"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Active conversation cleared: " + message);
        if (json.request_id === "active-002") {
            unsubscribe();
        }
    });
%}

### 3.3 Invalid UUID in active_conversation (should be silently ignored)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "active_conversation",
  "payload": {"conversation_id": "not-a-valid-uuid"},
  "request_id": "active-003"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Invalid UUID handled: " + message);
        // Should be silently ignored, no error response expected
        unsubscribe();
    });
%}

---

### ================================================================
### SECTION 4: SEND MESSAGE
### ================================================================

### 4.1 Send a text message
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Hello from WebSocket test!"
  },
  "request_id": "send-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Send message response: " + message);
        client.test("Received message_new or ack", () => {
            client.assert(json.type === "message_new");
        });
        client.test("Conversation ID matches", () => {
            client.assert(json.payload && json.payload.conversation_id === "{{conversationId}}");
        });
        client.test("Request ID matches", () => {
            client.assert(json.request_id === "send-001");
        });
        unsubscribe();
    });
%}

### 4.2 Send message with reply_to_id
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "This is a reply!",
    "reply_to_id": "REPLACE_WITH_MESSAGE_ID_TO_REPLY_TO"
  },
  "request_id": "send-002"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Reply response: " + message);
        if (json.request_id === "send-002") {
            unsubscribe();
        }
    });
%}

