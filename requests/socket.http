### ================================================================
### SECTION 11: MULTI-DEVICE SCENARIO (requires 2 tokens)
### ================================================================
### Device A (token A) and Device B (token B) are connected simultaneously.
### Messages sent by one should be received by the other via WS broadcast.
### ================================================================

### 11.1 Device A sends message, Device B receives via broadcast
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Multi-device test message"
  },
  "request_id": "multi-001"
}

> {%
    var broadcastReceived = false;
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Multi-device: " + message);
        if (json.type === "message_new" && json.request_id === undefined) {
            broadcastReceived = true;
            client.test("Broadcast received from other device", () => {
                client.assert(json.payload && json.payload.body === "Multi-device test message");
            });
        }
        if (json.request_id === "multi-001") {
            client.test("Ack received", () => {
                client.assert(true);
            });
            unsubscribe();
        }
    });
%}

---

### ================================================================
### SECTION 12: FULL INTEGRATION TEST
### ================================================================
### Complete workflow: connect -> set active -> send -> receive -> mark read
### ================================================================

### Full workflow
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "active_conversation",
  "payload": {"conversation_id": "{{conversationId}}"},
  "request_id": "flow-01"
}
=== wait-for-server
{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Integration test message"
  },
  "request_id": "flow-02"
}
=== wait-for-server
{
  "type": "typing",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "is_typing": false
  },
  "request_id": "flow-03"
}
=== wait-for-server
{
  "type": "active_conversation",
  "payload": {"conversation_id": null},
  "request_id": "flow-04"
}

> {%
    var step = 0;
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Flow [" + (++step) + "]: " + message);

        if (step >= 4) {
            client.test("Integration test completed", () => {
                client.assert(true);
            });
            unsubscribe();
        }
    });
%}