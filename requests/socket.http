%}

### 4.4 Empty body validation (should return error)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": ""
  },
  "request_id": "send-004"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Validation error: " + message);
        client.test("Received error", () => {
            client.assert(json.type === "error");
        });
        client.test("Request ID matches", () => {
            client.assert(json.request_id === "send-004");
        });
        unsubscribe();
    });
%}

### 4.5 Invalid conversation_id UUID (should return error)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "invalid-uuid",
    "body": "Test message"
  },
  "request_id": "send-005"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("UUID error: " + message);
        client.test("Received error for invalid UUID", () => {
            client.assert(json.type === "error");
        });
        unsubscribe();
    });
%}

### 4.6 Rate limiting test (send 5 messages rapidly)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Rate test 1"
  },
  "request_id": "rate-001"
}
=== wait-for-server
{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Rate test 2"
  },
  "request_id": "rate-002"
}
=== wait-for-server
{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Rate test 3"
  },
  "request_id": "rate-003"
}
=== wait-for-server
{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Rate test 4"
  },
  "request_id": "rate-004"
}
=== wait-for-server
{
  "type": "send_message",
  "payload": {
    "conversation_id": "{{conversationId}}",
    "body": "Rate test 5"
  },
  "request_id": "rate-005"
}

> {%
    var rateLimited = false;
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Rate test: " + message);
        if (json.type === "error" && json.payload && json.payload.code === 429) {
            rateLimited = true;
            client.test("Rate limited after 4 messages", () => {
                client.assert(true);
            });
        }
        if (json.request_id === "rate-005") {
            unsubscribe();
        }
    });
%}

