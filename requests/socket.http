### ================================================================
### SECTION 9: ERROR HANDLING
### ================================================================

### 9.1 Unknown frame type (should return error)
WEBSOCKET ws://localhost:8080/ws/chat?token={{accessToken}}
Content-Type: application/json

{
  "type": "unknown_frame_type",
  "payload": {},
  "request_id": "err-001"
}

> {%
    response.body.onEachMessage((message, unsubscribe) => {
        const json = JSON.parse(message);
        client.log("Unknown frame error: " + message);
        client.test("Received error for unknown frame", () => {
            client.assert(json.type === "error");
        });
        client.test("Error code is validation error (422)", () => {
            client.assert(json.payload && json.payload.code === 422);
        });
        unsubscribe();
    });
%}

