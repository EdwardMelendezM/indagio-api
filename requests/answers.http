@administrationId = 110f1415-7587-418c-ab10-1fa0888fbb7c

### Create answer (PHQ-8 item 1 — "Poco interés o placer en hacer cosas")
# Ruta real: POST /administrations/{administrationId}/answers
# (NO /projects/{projectId}/answers — esa ruta no existe en el router)
POST {{api}}/projects/{{projectId}}/administrations/{{administrationId}}/answers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "participant_id": "{{participantId}}",
  "instrument_id": "{{instrumentId}}",
  "question_key": "phq8_1",
  "answer_type": "scale",
  "value": { "raw": 2 },
  "client_generated_id": "client-answer-phq8-1"
}

### Create answer (PHQ-8 item 2 — "Decaído(a), deprimido(a) o sin esperanzas")
POST {{api}}/projects/{{projectId}}/administrations/{{administrationId}}/answers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "participant_id": "{{participantId}}",
  "instrument_id": "{{instrumentId}}",
  "question_key": "phq8_2",
  "answer_type": "scale",
  "value": { "raw": 1 },
  "client_generated_id": "client-answer-phq8-2"
}

### List participant answers
# NOTA: esta ruta filtra por participante en todo el proyecto, no por administration.
# Si necesitas solo los answers de una administración específica, ese endpoint
# de listado no existe todavía del lado HTTP (el repo sí tiene
# ListAnswersByAdministration, pero no está expuesto en un handler/ruta).
GET {{api}}/projects/{{projectId}}/participants/{{participantId}}/answers
Authorization: Bearer {{accessToken}}

### List participant answers filtered by instrument
GET {{api}}/projects/{{projectId}}/participants/{{participantId}}/answers?instrumentId={{instrumentId}}
Authorization: Bearer {{accessToken}}

### Create media record
POST {{api}}/projects/{{projectId}}/participants/{{participantId}}/media
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "answer_id": "{{answerId}}",
  "file_key": "uploads/participant-123/audio.mp3",
  "mime_type": "audio/mpeg",
  "size_bytes": 245760,
  "duration_seconds": 15,
  "checksum": "abc123def456"
}
