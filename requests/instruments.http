@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3ODkyNjg3NjgsImlhdCI6MTc4OTAwOTU2OCwicm9sZSI6ImVzdHVkaWFudGUiLCJ1c2VyX2lkIjoiNzJlYmRjODEtZmRkMS00MjU5LThkZTctOTc0YjhhN2I1NzQ3In0.TGW-H3Mw7HOGUWqLwxWIBvACZgLL4BhvH-22fEcZ_QU

@instrumentId = 33333333-3333-3333-3333-333333333333
@questionnaireId = 44444444-4444-4444-4444-444444444444
@projectId = c2f086da-0d38-407d-9c9b-1b32d6d4ee8b

### Create instrument
POST {{api}}/projects/{{projectId}}/instruments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Satisfaction survey",
  "description": "Short customer experience instrument.",
  "schema": {
    "type": "object",
    "properties": {
      "satisfaction": { "type": "number" },
      "comments": { "type": "string" }
    },
    "required": ["satisfaction"]
  }
}

### List instruments
GET {{api}}/projects/{{projectId}}/instruments
Authorization: Bearer {{accessToken}}

### Update instrument
PATCH {{api}}/projects/{{projectId}}/instruments/{{instrumentId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Satisfaction survey v2",
  "description": "Updated survey instrument.",
  "schema": {
    "type": "object",
    "properties": {
      "satisfaction": { "type": "number" },
      "comments": { "type": "string" }
    },
    "required": ["satisfaction"]
  }
}

### Create questionnaire
POST {{api}}/projects/{{projectId}}/questionnaires
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Baseline questionnaire",
  "description": "Initial data collection flow.",
  "items": [
    {"key": "age", "type": "number"},
    {"key": "country", "type": "string"}
  ]
}

### List questionnaires
GET {{api}}/projects/{{projectId}}/questionnaires
Authorization: Bearer {{accessToken}}

### Publish questionnaire
POST {{api}}/projects/{{projectId}}/questionnaires/{{questionnaireId}}/publish
Authorization: Bearer {{accessToken}}
